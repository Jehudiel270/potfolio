{
  "name": "portfolio-spatial-nuxt",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio spatial 3D dynamique (Nuxt, Neon, Cloudinary, Three.js, GSAP) avec back-office s\u00e9curis\u00e9.",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env scripts/seed.ts --demo",
    "db:purge-demo": "tsx --env-file-if-exists=.env scripts/purge-demo.ts",
    "db:purge-messages": "tsx --env-file-if-exists=.env scripts/purge-messages.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "check:shaders": "tsx scripts/check-shaders.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "cloudinary": "^2.11.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-vue-next": "^1.0.0",
    "nodemailer": "^10.1.7",
    "nuxt": "^4.6.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "world-atlas": "^2.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@nuxt/eslint": "^1.17.0",
    "@types/nodemailer": "^8.0.2",
    "@types/three": "^0.186.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "@types/node": "^22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
