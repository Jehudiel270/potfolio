# ───────────────────────── Base de données (Neon) ─────────────────────────
# Tableau de bord Neon → votre projet → "Connect" → chaîne de connexion « pooled » (avec ?sslmode=require)
DATABASE_URL=

# ───────────────────────── Session administrateur ─────────────────────────
# Chaîne aléatoire d'au moins 32 caractères :  openssl rand -base64 48
NUXT_SESSION_PASSWORD=

# ───────────────────────── Cloudinary ─────────────────────────
# Tableau de bord Cloudinary → "Settings" → "API Keys"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ───────────────────────── E-mail (SMTP) ─────────────────────────
# Nécessaire pour l'envoi du formulaire de contact par e-mail. Laisser vide = envoi désactivé (l'API répond alors clairement par une erreur, jamais par un faux succès).
SMTP_HOST=
SMTP_PORT=587
# "true" uniquement pour le port 465 (TLS implicite). Pour 587 laisser "false" (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex : Portfolio <no-reply@votre-domaine.com>
SMTP_FROM=
# Destinataire de secours si aucun destinataire n'est renseigné dans l'administration
CONTACT_FALLBACK_TO=

# ───────────────────────── Site ─────────────────────────
# URL publique (utilisée pour les métadonnées et la vérification d'origine)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ───────────────────────── Création du premier administrateur (script uniquement) ─────────────────────────
# Lus UNIQUEMENT par `pnpm admin:create`, à retirer ensuite.
ADMIN_EMAIL=
ADMIN_PASSWORD=
